# Optional, local only. Copy to .env.local (git-ignored through *.local). Nothing here is
# required; the Fortnox integration runs on rules alone without it.
#
# Fortnox credentials are NEVER put here. Locally they are read by path from the
# fortnox-agent repo's env file (scripts/fortnox-dev.ps1, FORTNOX_ENV_FILE); deployed,
# they are Supabase secrets on the project.

# One Claude call per customer or screen the matching rules could not settle
# (fuzzy or no candidate). Absent = rules only; the Fortnox-koppling page says which.
ANTHROPIC_API_KEY=

# Model for that call. Default: claude-sonnet-5
ANTHROPIC_MODEL=

# A recording of the kickoff meeting, if one exists on this machine. The builder takes
# single frames from it at the transcript's timestamps; nothing from it is committed.
VV_RECORDING=
